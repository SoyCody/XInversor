# Estos archivos se ejecutan en Linux (cPanel): con finales de línea CRLF de
# Windows, bash falla con errores tipo "$'\r': command not found".
*.sh text eol=lf
.cpanel.yml text eol=lf

# Código generado por Prisma: mismo fin de línea en cualquier PC y fuera de los diffs.
backend/generated/** text eol=lf linguist-generated -diff
