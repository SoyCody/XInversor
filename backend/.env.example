# Copiar a .env y completar con los valores reales. Ninguno de estos
# valores es válido tal cual está -- ver comentarios por variable.

# Cadena de conexión de Postgres que USA LA APP (ver
# https://pris.ly/d/connection-strings). En desarrollo local suele ser
# postgresql://usuario:contraseña@localhost:5432/XInversor
#
# Con Neon: usar la URL "pooled" (el host lleva "-pooler") y SIEMPRE con
# sslmode=require. connection_limit=5 evita abrir demasiadas conexiones
# desde un hosting compartido; connect_timeout da margen a que Neon
# "despierte" tras estar inactivo. NO incluir channel_binding=require.
#   postgresql://USUARIO:CLAVE@ep-xxxx-pooler.REGION.aws.neon.tech/BASE?sslmode=require&connection_limit=5&connect_timeout=15
DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/XInversor"

# SOLO en tu PC, nunca en el servidor: URL DIRECTA de Neon (mismo host pero
# SIN "-pooler") que usa `npm run migrate:deploy` para aplicar migraciones.
# DIRECT_URL="postgresql://USUARIO:CLAVE@ep-xxxx.REGION.aws.neon.tech/BASE?sslmode=require"

# Puerto donde escucha el backend. La mayoría de plataformas de
# despliegue (Render, Railway...) inyectan su propio PORT; si no lo
# hacen, se usa este valor o 3001 por defecto (ver src/server.js).
PORT=3001

# "development" en local. En producción DEBE ser "production": activa
# la cookie de sesión como Secure (solo viaja por HTTPS) y usa
# `prisma migrate deploy` en vez de `migrate dev` (ver README > Despliegue).
NODE_ENV=development

# Origen exacto (protocolo + dominio, sin barra final) donde corre el
# frontend. El backend solo acepta peticiones con credenciales desde
# este origen (ver server.js > cors()). En local: http://localhost:5173
# En producción: https://fxinversors.com (con https, sin barra final).
FRONTEND_URL=http://localhost:5173

# Secreto para firmar el JWT de sesión. Generar uno propio y largo, por
# ejemplo con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# NUNCA reusar el mismo valor entre entornos (dev/prod) ni committearlo.
JWT_SECRET=cambia-este-valor-por-uno-generado-y-secreto

# Días de vigencia del token de sesión.
JWT_EXPIRES_IN_DAYS=1

# "lax" alcanza si frontend y backend comparten dominio registrable
# (p. ej. app.xinversor.com + api.xinversor.com, aunque sean subdominios
# distintos). Si van a quedar en dominios TOTALMENTE distintos (p. ej.
# frontend en Vercel + backend en Railway), cambiar a "none" -- eso
# obliga automáticamente a que la cookie sea Secure (ver
# auth.middleware.js), así que el backend debe servir por HTTPS.
COOKIE_SAME_SITE=lax

# Cuántos saltos de proxy confiar delante del backend en producción (ver
# server.js). 1 alcanza para la mayoría de plataformas (un solo
# balanceador/edge delante de la app); subir si hay más de un proxy
# encadenado (p. ej. Cloudflare + el balanceador de la plataforma).
TRUST_PROXY=1

# Link de referido que se muestra en el dashboard del cliente (ver
# client.service.js#readDashboard). Es el mismo para todos los clientes,
# no vive en la base de datos.
CLIENT_REFERRAL_LINK=https://xinversor.example.com/ref/xxxx

# API key de Resend (resend.com/api-keys), usada para los correos de
# verificación de registro y cambio de contraseña.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Remitente de esos correos. Con una cuenta de Resend recién creada (sin
# dominio propio verificado) SOLO se puede usar el dominio de pruebas
# onboarding@resend.dev, y ese dominio de pruebas SOLO entrega al correo
# con el que se creó la cuenta de Resend -- para mandar a clientes reales
# hace falta verificar un dominio propio en resend.com/domains y apuntar
# esto a una dirección de ese dominio.
RESEND_FROM_EMAIL="XInversor <onboarding@resend.dev>"
