// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CLIENT
}

enum State {
  BORRADO
  ACTIVO
}

enum EstadoInversion {
  PENDIENTE
  EN_PROGRESO
  RETIRADO
}

enum EstadoSolicitud {
  PENDIENTE
  ACEPTADA
  RECHAZADA
}

model User {
  id              Int       @id @default(autoincrement())
  firstName       String
  lastName        String
  email           String    @unique
  passwordHash    String
  role            Role      @default(CLIENT)
  createdAt       DateTime  @default(now())
  apdatedAt       DateTime  @updatedAt
  state           State     @default(ACTIVO)
  avatar          Bytes?
  avatarType      String?
  avatarUpdatedAt DateTime?
  client          Client?
  admin           Admin?
  audits          Audit[]
}

model Client {
  id          Int         @id @default(autoincrement())
  userId      Int         @unique
  link        String      @default("https://accounts.binance.bh/en-BH/register?ref=XZV234DGDGD2&registerChannel=&return_to=aHR0cHM6Ly93d3cuYmluYW5jZS5iaC9lbi1CSC92aXAtaW5zdGl0dXRpb25hbC1zZXJ2aWNlcz9yZWY9WkhIRlNZSU0%3D")
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  blocked     Boolean     @default(false)
  inversiones Inversion[]
}

model Admin {
  id          Int         @id @default(autoincrement())
  userId      Int         @unique
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  solicitudes Solicitud[]
}

model Audit {
  id        Int      @id @default(autoincrement())
  userId    Int
  action    String
  tableName String
  targetId  Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Inversion {
  id          Int         @id @default(autoincrement())
  clientId    Int
  monto       Decimal     @db.Decimal(14, 2) 
  dias        Int         @default(0)
  total       Decimal     @default(0) @db.Decimal(18, 8)
  intereses   Decimal     @default(0) @db.Decimal(18, 8) 
  createdAt   DateTime    @default(now())
  client      Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  estados     Estado[]
  solicitudes Solicitud[]
}

model Solicitud {
  id          Int             @id @default(autoincrement())
  inversionId Int
  montoRetiro Decimal         @db.Decimal(18, 8)
  estado      EstadoSolicitud @default(PENDIENTE)
  pendiente   Boolean?        @default(true)
  adminId     Int?
  resueltaEn  DateTime?
  createdAt   DateTime        @default(now())
  inversion   Inversion       @relation(fields: [inversionId], references: [id], onDelete: Cascade)
  admin       Admin?          @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@unique([inversionId, pendiente])
}

model Estado {
  id          Int             @id @default(autoincrement())
  inversionId Int
  estado      EstadoInversion @default(PENDIENTE)
  createdAt   DateTime        @default(now())
  inversion   Inversion       @relation(fields: [inversionId], references: [id], onDelete: Cascade)
}
