// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CLIENT
}

enum State {
  BORRADO
  ACTIVO
}

enum EstadoInversion {
  PENDIENTE
  RECHAZADO
  EN_ESPERA
  EN_PROGRESO
  RETIRADO
}

enum EstadoSolicitud {
  PENDIENTE
  ACEPTADA
  RECHAZADA
}

model User {
  id              Int       @id @default(autoincrement())
  firstName       String
  lastName        String
  email           String    @unique
  passwordHash    String
  role            Role      @default(CLIENT)
  createdAt       DateTime  @default(now())
  // NOTA: el campo está mal escrito ("apdatedAt" en vez de "updatedAt").
  // Renombrarlo es un cambio de contrato (el JSON de /admin/watch/user/:id
  // expone esta clave y el frontend la consume), así que se deja como
  // está; si algún día se renombra, hacerlo con @map("apdatedAt") para no
  // romper una cosa ni la otra de golpe.
  apdatedAt       DateTime  @updatedAt
  state           State     @default(ACTIVO)
  avatar          Bytes?
  avatarType      String?
  avatarUpdatedAt DateTime?
  client          Client?
  admin           Admin?
  audits          Audit[]

  // Listado de admin: WHERE state = ? ORDER BY createdAt DESC + paginado.
  @@index([state, createdAt])
}

model Client {
  id          Int         @id @default(autoincrement())
  userId      Int         @unique
  // Puede ser null: una cuenta nace como CLIENT sin wallet; recién se
  // exige tenerla para poder crear inversiones. Además, si un admin
  // asciende a la cuenta al instante, puede que nunca la configure.
  wallet      String?
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  blocked     Boolean     @default(false)
  inversiones Inversion[]
}

model Admin {
  id          Int         @id @default(autoincrement())
  userId      Int         @unique
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  solicitudes Solicitud[]
}

model Audit {
  id        Int      @id @default(autoincrement())
  userId    Int
  action    String
  tableName String
  targetId  Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Postgres NO indexa las FK por sí solo. El listado ordena por createdAt
  // y hace JOIN con user en cada fila.
  @@index([createdAt])
  @@index([userId])
}

model Inversion {
  id          Int         @id @default(autoincrement())
  clientId    Int
  monto       Decimal     @default(0) @db.Decimal(18, 8)
  // Porcentaje de intereses vigente al momento de crear el paquete,
  // congelado acá (en vez de leer siempre Configuracion.porcentajeInteres)
  // para que un cambio futuro del porcentaje global no reescriba
  // retroactivamente los intereses ya generados por esta inversión.
  porcentajeInteres Decimal @default(0.10) @db.Decimal(5, 4)
  dias        Int         @default(0)
  total       Decimal     @default(0) @db.Decimal(18, 8)
  intereses   Decimal     @default(0) @db.Decimal(18, 8)
  createdAt   DateTime    @default(now())
  client      Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  estados     Estado[]
  solicitudes Solicitud[]

  // myList: WHERE clientId = ? ORDER BY createdAt DESC.
  @@index([clientId, createdAt])
}

model Solicitud {
  id          Int             @id @default(autoincrement())
  inversionId Int
  montoRetiro Decimal         @db.Decimal(18, 8)
  estado      EstadoSolicitud @default(PENDIENTE)
  pendiente   Boolean?        @default(true)
  adminId     Int?
  resueltaEn  DateTime?
  createdAt   DateTime        @default(now())
  inversion   Inversion       @relation(fields: [inversionId], references: [id], onDelete: Cascade)
  admin       Admin?          @relation(fields: [adminId], references: [id], onDelete: SetNull)

  // `pendiente` es Boolean? a propósito: el índice único garantiza "una
  // sola solicitud pendiente por inversión" mientras vale true. Al
  // resolver una solicitud hay que poner pendiente = NULL (no false),
  // porque Postgres trata cada NULL como distinto y así se permiten
  // varias solicitudes resueltas para la misma inversión.
  @@unique([inversionId, pendiente])
  @@index([adminId])
}

// Fila única (id fijo = 1) con parámetros globales editables desde el
// panel de administración. Hoy solo el porcentaje de intereses que se
// aplica a las inversiones nuevas (ver Investment.newInvestment).
model Configuracion {
  id                Int      @id @default(1)
  porcentajeInteres Decimal  @default(0.10) @db.Decimal(5, 4)
  updatedAt         DateTime @updatedAt
}

model Estado {
  id          Int             @id @default(autoincrement())
  inversionId Int
  estado      EstadoInversion @default(PENDIENTE)
  createdAt   DateTime        @default(now())
  inversion   Inversion       @relation(fields: [inversionId], references: [id], onDelete: Cascade)

  // Se lee siempre como "último estado por inversión":
  // WHERE inversionId = ? ORDER BY createdAt DESC LIMIT 1.
  @@index([inversionId, createdAt])
}
