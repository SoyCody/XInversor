# Copiar a .env (o .env.production para el build de despliegue) y
# completar. Vite solo expone al cliente las variables con prefijo
# VITE_ -- ver https://vite.dev/guide/env-and-mode.

# URL base del backend, SIN barra final. En local coincide con el valor
# por defecto de httpClient.js (http://localhost:3001), así que esta
# variable es opcional en desarrollo; en el build de producción es
# obligatoria y debe apuntar al backend ya desplegado.
VITE_API_URL=https://api.xinversor.example.com
