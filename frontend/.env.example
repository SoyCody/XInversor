# Copiar a .env (o .env.production para el build de despliegue) y
# completar. Vite solo expone al cliente las variables con prefijo
# VITE_ -- ver https://vite.dev/guide/env-and-mode.

# URL base del backend, SIN barra final. En desarrollo es opcional: si no se
# define, httpClient.js usa http://localhost:3001. En el build de producción
# es OBLIGATORIA (si falta, la app falla con un mensaje claro). Para
# fxinversors.com el valor está en frontend/.env.production.
VITE_API_URL=https://api.xinversor.example.com
